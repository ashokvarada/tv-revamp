<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- TMDB: the daily discover queries and the images. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 14 requires it for jobs that wait for a network. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Keeps the daily job scheduled across reboots. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android's Continue watching rows (granted over adb: pm grant com.tvlatest android.permission.READ_TV_LISTINGS). -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />

    <!-- Android 11+ package visibility: which streaming apps are installed, and Google TV's search. -->
    <queries>
        <package android:name="com.netflix.ninja" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.hulu.livingroomplus" />
        <package android:name="com.apple.atve.androidtv.appletv" />
        <package android:name="com.wbd.stream" />
        <package android:name="com.crunchyroll.crunchyroid" />
        <package android:name="com.graymatrix.did" />
        <package android:name="com.tubitv" />
        <package android:name="com.plexapp.android" />
        <package android:name="com.google.android.youtube.tv" />
        <!-- The launcher, for the rail's Home. -->
        <package android:name="com.gathin.tvhome" />
        <intent>
            <action android:name="android.search.action.GLOBAL_SEARCH" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <activity
            android:name=".LatestActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".FetchJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Read-only, public catalogue data for the launcher's backdrops. -->
        <provider
            android:name=".LatestProvider"
            android:authorities="com.tvlatest.latest"
            android:exported="true" />
    </application>
</manifest>
