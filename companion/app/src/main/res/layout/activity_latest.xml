<?xml version="1.0" encoding="utf-8"?>
<!-- Explore: mood rows of uncropped posters on charcoal, a compact hero for the focused title, and the left rail. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="76dp">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:paddingStart="12dp"
            android:paddingTop="30dp"
            android:paddingEnd="380dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.2"
                android:textColor="#80FFFFFF"
                android:textSize="10sp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:gravity="bottom|start"
                android:fontFamily="sans-serif-light"
                android:textColor="#FFFFFFFF"
                android:maxLines="2"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="18sp"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/overview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.2"
                android:maxLines="3"
                android:ellipsize="end" />

                <!-- The gist: OK on a poster opens it in place, over the rows. -->
                <LinearLayout
                    android:id="@+id/gistButtons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/btnWatch"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:focusable="true"
                        android:textColor="#FFFFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:text="▶  Watch now" />

                    <TextView
                        android:id="@+id/btnHide"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="12dp"
                        android:gravity="center"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:focusable="true"
                        android:textColor="#FFFFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Not interested" />
                </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="60dp"
            android:clipToPadding="false" />
    </LinearLayout>

    <!-- Behind the side bar while it is open (Prime Video style). -->
    <View
        android:id="@+id/railShade"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/rail_shade"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- The left rail, the same as on Home: Home and Explore. -->
    <LinearLayout
        android:id="@+id/rail"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="10dp"
        android:background="@drawable/rail_bg"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:id="@+id/railHome"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/rail_item"
            android:drawableStart="@drawable/ic_rail_home"
            android:drawablePadding="14dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minWidth="44dp"
            android:paddingStart="10dp"
            android:paddingEnd="18dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:contentDescription="Home" />

        <TextView
            android:id="@+id/railExplore"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rail_item"
            android:drawableStart="@drawable/ic_rail_explore"
            android:drawablePadding="14dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minWidth="44dp"
            android:paddingStart="10dp"
            android:paddingEnd="18dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:contentDescription="Explore" />

        <TextView
            android:id="@+id/railPersonalize"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rail_item"
            android:drawableStart="@drawable/ic_rail_personalize"
            android:drawablePadding="14dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minWidth="44dp"
            android:paddingStart="10dp"
            android:paddingEnd="18dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:contentDescription="Personalize" />
    </LinearLayout>

    <!-- Refresh: pulls the latest titles from TMDB now. Up from the first row reaches it. -->
    <ImageView
        android:id="@+id/btnRefresh"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="48dp"
        android:padding="10dp"
        android:src="@drawable/ic_refresh"
        android:focusable="true"
        android:contentDescription="Refresh" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="#CCFFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />
</FrameLayout>
